<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      鹰角网络 Arknights 机能工业风（浅色基底）：浅灰底 + 酸橙绿互动点缀。

      windowBackground / colorBackground 刻意**不写**：父主题是 DayNight，
      它会按系统深浅模式自动选择底色。之前这里把它们显式写死成 @color/background，
      把父主题的自动适配盖掉了，结果系统切深色时界面底色仍是浅的、而对话框等
      系统绘制的部分已经变深 —— 就是那种「混搭」。
    -->
    <style name="Theme.PersonalAccounting" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <!-- 酸橙绿按钮上的字固定黑：深色下按钮仍是酸橙绿，黑字才够对比 -->
        <item name="colorOnPrimary">#000000</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <!--
          禁止系统「强制深色」(force dark)：本应用自带完整的深浅两套配色，
          交给系统强转只会出事 —— 它按启发式只反文字不反背景，
          结果就是白字压在浅灰底上完全看不清。API 29 以下无此属性，会被忽略。
        -->
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <!--
          输入框的 hint 与光标必须显式钉住：hint 色不随 textColorPrimary 走，
          不声明的话会取父主题的浅色值 —— 深色底上直接白字压白底看不见。
        -->
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <!-- 描边按钮也走同一套按压语言（Material 默认的圆形水波纹同样要去掉） -->
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Outlined</item>
    </style>

    <!--
      直角矩形工业按钮：酸橙绿实心黑字、无圆角。

      按压反馈不用 Material 的圆形水波纹 —— 那个圆形扩散与这套直角工业语言不搭，
      它的缓动偏柔和，也与「冷峻克制」的机械感相反。这里把 rippleColor 设为透明，
      改用 backgroundTint 的**状态选择器**做填充反转：按下瞬间变黑底、文字转酸橙绿。
      规范里对交互反馈的要求正是「颜色变化或简单的填充/描边切换」。

      父样式必须留在 MaterialComponents 一侧：24 个描边按钮经由
      Widget.MaterialComponents.Button.OutlinedButton → Widget.App.Button 这条链
      间接拿到圆角等设置，换成 AppCompat 会一起断掉。
    -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="cornerRadius">0dp</item>
        <item name="backgroundTint">@color/btn_tint_filled</item>
        <item name="android:textColor">@color/btn_text_filled</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!--
      描边按钮：透明底 + 酸橙绿描边，按下反转为酸橙绿填充。
      textColor 用选择器，按下时从酸橙绿变黑 —— 否则会在酸橙绿底上留酸橙绿字。
    -->
    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">0dp</item>
        <item name="backgroundTint">@color/btn_tint_outlined</item>
        <item name="android:textColor">@color/btn_text_outlined</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
