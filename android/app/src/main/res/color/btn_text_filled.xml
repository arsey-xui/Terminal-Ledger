<?xml version="1.0" encoding="utf-8"?>
<!--
  实心按钮的文字色跟随填充反转：默认黑（压在酸橙绿上），按下转酸橙绿（压在黑底上）。
  与 btn_tint_filled.xml 必须成对修改，否则会出现「黑底黑字」。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="@color/primary" />
    <item android:state_enabled="false" android:color="@color/text_secondary" />
    <item android:color="#000000" />
</selector>
