<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!--
          外观：深浅模式。放在最前面是因为它要用来区分两件事 ——
          「配色本身好不好看」与「跟随系统是否正常」。
          强制浅色/深色可以绕开系统的「强制深色」干扰，直接看到应用自己的一套配色。
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="外观"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
        <Button
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:id="@+id/btn_theme_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="深浅模式：跟随系统"
            android:textColor="@color/text_primary"
            app:cornerRadius="0dp"
            app:strokeColor="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="云端地址"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace" />
        <EditText
            android:id="@+id/url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary" />
        <Button
            android:id="@+id/btn_save_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="保存地址" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="同步"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btn_sync_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="立即同步" />
        <TextView
            android:id="@+id/sync_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:fontFamily="monospace" />
        <!-- 只在「最近一次同步失败且还没被成功覆盖」时露出来 -->
        <Button
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:id="@+id/btn_sync_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重试同步"
            android:textColor="@color/text_primary"
            android:visibility="gone"
            app:cornerRadius="0dp"
            app:strokeColor="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="数据管理"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
        <Button
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:id="@+id/btn_manage_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="管理分类（含删除）"
            android:textColor="@color/text_primary"
            app:cornerRadius="0dp"
            app:strokeColor="@color/accent" />
        <Button
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:id="@+id/btn_manage_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="管理账户（含删除）"
            android:textColor="@color/text_primary"
            app:cornerRadius="0dp"
            app:strokeColor="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <Button
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btn_reset_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="重置分类"
                android:textColor="@color/text_primary"
                app:cornerRadius="0dp"
                app:strokeColor="@color/accent" />
            <Button
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btn_reset_account"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="重置账户"
                android:textColor="@color/text_primary"
                app:cornerRadius="0dp"
                app:strokeColor="@color/accent" />
        </LinearLayout>
        <Button
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:id="@+id/btn_reset_budget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="重置预算管理（清空所有上限）"
            android:textColor="@color/text_primary"
            app:cornerRadius="0dp"
            app:strokeColor="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="周期记账（自动续费 / 固定月供）"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/recurring_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="到期后会生成「待确认」项，确认后才写入流水。"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
        <LinearLayout
            android:id="@+id/recurring_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <Button
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:id="@+id/btn_add_recurring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="新建周期规则"
            android:textColor="@color/text_primary"
            app:cornerRadius="0dp"
            app:strokeColor="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="备份与导出"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="备份含全部流水、分类、账户、预算、模板与周期规则，用口令加密（AES-256），格式与电脑端一致、可互相恢复。CSV 只导出流水明细。"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
        <Button
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:id="@+id/btn_export_csv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="导出 CSV（流水明细）"
            android:textColor="@color/text_primary"
            app:cornerRadius="0dp"
            app:strokeColor="@color/accent" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btn_backup_export"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="导出备份"
                android:textColor="@color/text_primary"
                app:cornerRadius="0dp"
                app:strokeColor="@color/accent" />
            <Button
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btn_backup_import"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="导入备份"
                android:textColor="@color/text_primary"
                app:cornerRadius="0dp"
                app:strokeColor="@color/accent" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="版本"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/version_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前版本：-"
            android:textColor="@color/text_primary"
            android:fontFamily="monospace" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btn_check_update"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="检查更新"
                android:textColor="@color/text_primary"
                app:cornerRadius="0dp"
                app:strokeColor="@color/accent" />
            <Button
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btn_update_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="更新源"
                android:textColor="@color/text_primary"
                app:cornerRadius="0dp"
                app:strokeColor="@color/accent" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
