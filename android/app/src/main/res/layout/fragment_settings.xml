<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="云端地址"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace" />
        <EditText
            android:id="@+id/url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary" />
        <Button
            android:id="@+id/btn_save_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="保存地址" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="同步"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btn_sync_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="立即同步" />
        <TextView
            android:id="@+id/sync_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="数据管理"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
        <Button
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:id="@+id/btn_manage_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="管理分类（含删除）"
            android:textColor="@color/text_primary"
            app:cornerRadius="0dp"
            app:strokeColor="@color/accent" />
        <Button
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:id="@+id/btn_manage_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="管理账户（含删除）"
            android:textColor="@color/text_primary"
            app:cornerRadius="0dp"
            app:strokeColor="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <Button
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btn_reset_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="重置分类"
                android:textColor="@color/text_primary"
                app:cornerRadius="0dp"
                app:strokeColor="@color/accent" />
            <Button
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btn_reset_account"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="重置账户"
                android:textColor="@color/text_primary"
                app:cornerRadius="0dp"
                app:strokeColor="@color/accent" />
        </LinearLayout>
        <Button
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:id="@+id/btn_reset_budget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="重置预算管理（清空所有上限）"
            android:textColor="@color/text_primary"
            app:cornerRadius="0dp"
            app:strokeColor="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="高级"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
        <Button
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:id="@+id/btn_export_csv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="导出 CSV（电脑端数据管理）"
            android:textColor="@color/text_primary"
            app:cornerRadius="0dp"
            app:strokeColor="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="版本"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/version_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前版本：-"
            android:textColor="@color/text_primary"
            android:fontFamily="monospace" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btn_check_update"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="检查更新"
                android:textColor="@color/text_primary"
                app:cornerRadius="0dp"
                app:strokeColor="@color/accent" />
            <Button
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btn_update_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="更新源"
                android:textColor="@color/text_primary"
                app:cornerRadius="0dp"
                app:strokeColor="@color/accent" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
